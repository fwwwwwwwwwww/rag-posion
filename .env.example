# 复制本文件为 .env 并按需修改

# ---------------- 数据库 ----------------
# MySQL（配合 docker-compose.yml 使用）：
DATABASE_URL=mysql+pymysql://rag:rag_password@localhost:3306/rag_experiments?charset=utf8mb4
# 本地无 MySQL 时自动降级 SQLite（也可显式指定）：
# DATABASE_URL=sqlite:///./data/rag_experiments.db

# ---------------- Ollama（RAG 实验使用） ----------------
OLLAMA_BASE_URL=http://localhost:11434

# ================= 安全配置（重要） =================

# 会话签名密钥。**生产环境必须改成足够长的随机串**：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不配置时服务启动会随机生成，副作用是进程重启后所有登录状态失效
# （这比用一个硬编码默认密钥安全：后者等于任何人都能伪造会话）。
SESSION_SECRET=

# 会话有效期（秒），默认 12 小时
SESSION_TTL=43200
# 会话 Cookie 名称
SESSION_COOKIE_NAME=rag_session
# 是否只在 HTTPS 下发送会话 Cookie。
# 本地 http 调试必须为 false，否则浏览器不会回传 Cookie；
# 部署到 HTTPS 后请改为 true。
SESSION_COOKIE_SECURE=false

# 初始管理员账号。首次启动（users 表为空）时创建。
# 不配置 ADMIN_PASSWORD 时会随机生成密码并**只打印到启动日志一次**——
# 这是刻意的：避免任何硬编码默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 旧版静态 Token：保留给脚本/CI 调用（浏览器走登录会话，不用它）。
#
# **默认留空 = 禁用**。不要在这里写任何示例值——示例值会被照抄上线，
# 等于给所有人留了一把可用的钥匙。确实需要脚本调用时再填长随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# ---------------- RAG / Agent ----------------
# Agent 需要模型具备原生工具调用能力：qwen3.5:2b 实测最稳。
RAG_LLM_MODEL=qwen3.5:2b
RAG_EMBEDDING_MODEL=qwen3-embedding:latest
RETRIEVAL_K_DEFAULT=3
AGENT_MAX_STEPS=8

# embedding 是否放 CPU 跑。本机 8GB 显存装不下
# embedding(6.34GB)+对话模型(2.36GB)，同机会互相驱逐并返回空响应。
# 在线问答建议 true；批量重建索引请用 GPU（见 tests/rebuild_vectordb.py）。
EMBED_ON_CPU=true

# ---------------- Celery / Redis（可选） ----------------
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 复制本文件为 .env 并按需修改
# 数据库连接地址（SQLAlchemy URL）
# MySQL（配合 docker-compose.yml 使用）：
DATABASE_URL=mysql+pymysql://rag:rag_password@localhost:3306/rag_experiments?charset=utf8mb4
# 本地无 MySQL 时的降级方案（SQLite）：
# DATABASE_URL=sqlite:///./data/rag_experiments.db

# Ollama 服务地址（RAG 实验使用）
OLLAMA_BASE_URL=http://localhost:11434

# 鉴权 Token（演示用，客户端在 Authorization: Bearer <token> 中携带）
AUTH_TOKEN=rag-demo-token

# Celery / Redis（可选，文档批量向量化）
# 设为 true 启用 Celery，需要 Redis 运行
CELERY_ENABLED=false
REDIS_URL=redis://localhost:6379/0
